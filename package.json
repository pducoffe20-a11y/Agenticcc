{
  "name": "agenticcc-d2l-sales-workflows",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "quality": "npm run validate:skills && npm run validate:registry && npm run validate:agents && npm run generate:catalog && git diff --exit-code -- app/src/generated/launchpad-catalog.json && npm run validate:promptfoo",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "validate:agents": "node scripts/validate-agents.mjs",
    "generate:catalog": "node scripts/generate-launchpad-catalog.mjs",
    "validate:promptfoo": "node scripts/run-promptfoo.mjs validate",
    "eval:workflows": "node scripts/run-promptfoo.mjs eval",
    "skills:list": "npx --yes skills@1.5.20 add ./plugins/d2l-sales-workflows --list",
    "test": "node --test && npm --prefix app test -- --run",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm run generate:catalog && npm --prefix app run build",
    "app:test": "npm --prefix app test -- --run"
  }
}
